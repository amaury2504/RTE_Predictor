# Copier en ".env" sur le serveur (jamais dans git) et remplir.

# Clé de signature des jetons. Générer avec :  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_GENEREE
# Durée de validité d'un jeton, en minutes
DURATION_TOKEN=60
# true : le bouton "continuer en invité" fonctionne (démo). false : comptes obligatoires.
GUEST_ENABLED=true
# Seulement si le frontend est servi sur un AUTRE domaine que l'API (inutile avec la configuration fournie)
# ALLOWED_ORIGINS=https://rte.example.com
